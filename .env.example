# APP_ENV: local | staging | production. Cloud auth + HTTPS required for staging/production.
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; used only by the opportunity importer, never by browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Local seeded accounts; use scripts/configure-local-accounts.mjs to generate hashes.
HC_SESSION_SECRET=
HC_STUDENT_PASSWORD_HASH=
HC_PRO_PASSWORD_HASH=
HC_COOKIE_SECURE=false
# Test scripts only: provide privately; never commit passwords.
HC_STUDENT_EMAIL=
HC_PRO_EMAIL=
# HC_STUDENT_PASSWORD / HC_PRO_PASSWORD are used by the configuration and browser-check scripts.
