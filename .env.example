# APP_ENV: local | staging | production. Cloud auth + HTTPS required for staging/production.
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; used only by the opportunity importer, never by browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Local seeded accounts; use scripts/configure-local-accounts.mjs to generate hashes.
BUILDORA_SESSION_SECRET=
BUILDORA_STUDENT_PASSWORD_HASH=
BUILDORA_PRO_PASSWORD_HASH=
BUILDORA_COOKIE_SECURE=false
# Optional local persistence directory and manual verification reviewer emails.
BUILDORA_LOCAL_DATA_DIR=.local-data
BUILDORA_REVIEWER_EMAILS=
# Test scripts only: provide privately; never commit passwords.
BUILDORA_STUDENT_EMAIL=
BUILDORA_PRO_EMAIL=
# BUILDORA_STUDENT_PASSWORD / BUILDORA_PRO_PASSWORD are used by the configuration and browser-check scripts.
